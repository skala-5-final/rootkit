# 로컬 개발(pnpm dev)용. docker compose의 web 컨테이너는 compose 파일의 값을 사용한다.
DATABASE_URL=postgres://rootkit:rootkit@localhost:5433/rootkit

# FastAPI(AI 서버) 연동 — 서버 전용, 브라우저에 노출 금지
AI_API_BASE_URL=http://localhost:8000

# JWT 서명 키 (32자 이상). 생성: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

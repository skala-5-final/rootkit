# AI_API_TOKEN is shared with web/.env; do not override it here.
AI_DB_PATH=data/rootkit.sqlite3
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# Default model used when a task-specific name below is empty.
MODEL_NAME=
# Optional task-specific models: generation/extraction, evaluation, independent review.
MODEL_GENERATION_NAME=
MODEL_EVALUATION_NAME=
MODEL_REVIEW_NAME=
# Optional reasoning for evaluation/review primary models only (never sent to fallback).
# gpt-5.4-mini supports none/low/medium/high/xhigh; verify other models before setting.
# When using low/medium/high/xhigh, leave MODEL_TEMPERATURE empty below.
MODEL_EVALUATION_REASONING_EFFORT=
MODEL_REVIEW_REASONING_EFFORT=
# json_object is compatible with most OpenAI-compatible providers.
# Set json_schema only when the chosen models support strict structured outputs.
MODEL_RESPONSE_FORMAT=json_object
# Leave empty for the provider/model default; supported range: 0 through 2.
MODEL_TEMPERATURE=
# Request timeouts; catalog generation/review may need more time than evaluation.
MODEL_TIMEOUT_SECONDS=25
MODEL_CATALOG_TIMEOUT_SECONDS=90
# Total deadline shared by evaluation, review, retries and any correction attempt (max 180).
EVALUATION_TIMEOUT_SECONDS=120
# At most one feedback correction after a schema/independent-review mismatch.
EVALUATION_REPAIR_ATTEMPTS=1
# Only transient 429/5xx/connection failures retry; 0 or 1 same-model retry.
MODEL_MAX_RETRIES=1
# Optional explicitly selected fallback, tried once only after transient transport failures.
# Review rejection, invalid JSON/schema, auth and request errors never trigger fallback.
MODEL_FALLBACK_NAME=
